# Path al archivo JSON de la Service Account.
# Debe estar fuera de cualquier carpeta servida públicamente.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Project ID de GCP donde se ejecutarán los jobs de BigQuery.
GCP_PROJECT_ID=fechaestimadaentregaprod

# Ubicación del dataset (US, EU, us-central1, etc.)
BQ_LOCATION=US

# Puerto del backend (Vite hace proxy aquí)
PORT=3001

# ── Validación ATP (vista Validación ATP · solo SBB Decomm) ──
# URL del servicio de disponibilidad en el OMS de Suburbia y credencial Basic.
# Si no se definen, el backend usa los valores por defecto del código.
# OMS_ATP_URL=https://oms.suburbia.com.mx/smcfs/restapi/executeFlow/EPLInventoryAvailabilityWebService
# OMS_ATP_AUTH=Basic <base64(usuario:password)>   ← pon la real SOLO en .env
