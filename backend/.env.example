# Path al archivo JSON de la Service Account.
# Debe estar fuera de cualquier carpeta servida públicamente.
# Sin service-account.json local: se usa Application Default Credentials (gcloud auth application-default login)
# GCP_CREDENTIALS_FILE=./service-account.json

# Project ID de GCP donde se ejecutarán los jobs de BigQuery.
GCP_PROJECT_ID=fechaestimadaentregaprod

# Ubicación del dataset (US, EU, us-central1, etc.)
BQ_LOCATION=US

# Puerto del backend en local (Vite hace proxy aquí). Opcional: si no se
# define, el binario usa 8080 por default. En Cloud Run, PORT lo inyecta
# la plataforma en runtime y este valor no aplica.
# PORT=8080

# ── Validación ATP (vista Validación ATP · solo SBB Decomm) ──
# Credencial Basic del OMS de Suburbia. Sin ella /api/atp-validate responde
# 503. La URL es opcional (hay default en código). La credencial real va
# SOLO en .env (gitignoreado), nunca aquí.
# OMS_ATP_URL=https://oms.suburbia.com.mx/smcfs/restapi/executeFlow/EPLInventoryAvailabilityWebService
# OMS_ATP_AUTH=Basic <base64(usuario:password)>
